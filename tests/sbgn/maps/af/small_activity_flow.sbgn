<?xml version="1.0" encoding="UTF-8"?>
<sbgn xmlns="http://sbgn.org/libsbgn/0.3">
    <map id="small_activity_flow" language="activity flow">
        <bbox x="0.0" y="0.0" w="800.0" h="600.0"/>
        <glyph id="compartment" class="compartment">
            <label text="cell"/>
            <bbox x="20.0" y="20.0" w="760.0" h="560.0"/>
        </glyph>
        <glyph id="activity_a" class="biological activity" compartmentRef="compartment">
            <label text="A"/>
            <bbox x="60.0" y="80.0" w="120.0" h="60.0"/>
            <glyph id="activity_a_unit" class="unit of information">
                <label text="A"/>
                <entity name="macromolecule"/>
                <bbox x="70.0" y="74.0" w="24.0" h="12.0"/>
            </glyph>
        </glyph>
        <glyph id="activity_b" class="biological activity" compartmentRef="compartment">
            <label text="B"/>
            <bbox x="60.0" y="280.0" w="120.0" h="60.0"/>
        </glyph>
        <glyph id="activity_c" class="biological activity" compartmentRef="compartment">
            <label text="C"/>
            <bbox x="460.0" y="180.0" w="120.0" h="60.0"/>
        </glyph>
        <glyph id="phenotype" class="phenotype" compartmentRef="compartment">
            <label text="P"/>
            <bbox x="460.0" y="420.0" w="120.0" h="60.0"/>
        </glyph>
        <glyph id="and_operator" class="and">
            <bbox x="300.0" y="190.0" w="40.0" h="40.0"/>
            <port id="and_operator.1" x="280.0" y="210.0"/>
            <port id="and_operator.2" x="360.0" y="210.0"/>
        </glyph>
        <glyph id="tag" class="tag" orientation="right">
            <label text="C"/>
            <bbox x="640.0" y="190.0" w="80.0" h="40.0"/>
        </glyph>
        <glyph id="submap" class="submap">
            <label text="S"/>
            <bbox x="60.0" y="440.0" w="160.0" h="100.0"/>
            <glyph id="terminal" class="terminal" orientation="up">
                <label text="A"/>
                <bbox x="120.0" y="440.0" w="40.0" h="20.0"/>
            </glyph>
        </glyph>
        <arc id="logic_arc_a" class="logic arc" source="activity_a" target="and_operator.1">
            <start x="180.0" y="110.0"/>
            <end x="280.0" y="210.0"/>
        </arc>
        <arc id="logic_arc_b" class="logic arc" source="activity_b" target="and_operator.1">
            <start x="180.0" y="310.0"/>
            <end x="280.0" y="210.0"/>
        </arc>
        <arc id="positive_influence" class="positive influence" source="and_operator.2" target="activity_c">
            <start x="360.0" y="210.0"/>
            <end x="460.0" y="210.0"/>
        </arc>
        <arc id="negative_influence" class="negative influence" source="activity_c" target="activity_a">
            <start x="460.0" y="190.0"/>
            <end x="180.0" y="90.0"/>
        </arc>
        <arc id="necessary_stimulation" class="necessary stimulation" source="activity_c" target="phenotype">
            <start x="520.0" y="240.0"/>
            <end x="520.0" y="420.0"/>
        </arc>
        <arc id="tag_equivalence_arc" class="equivalence arc" source="activity_c" target="tag">
            <start x="580.0" y="210.0"/>
            <end x="640.0" y="210.0"/>
        </arc>
        <arc id="terminal_equivalence_arc" class="equivalence arc" source="activity_a" target="terminal">
            <start x="120.0" y="140.0"/>
            <end x="140.0" y="440.0"/>
        </arc>
    </map>
</sbgn>
